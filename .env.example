# SYSTEMBOOM prototype — copy to .env.local and fill in.
#
# Google Maps Platform key for the Earth Explorer.
# Required APIs on the key's project:
#   - Maps JavaScript API      (3D Map3DElement + camera animation)
#   - Places API (New)         (Place.searchByText)
# Restrict the key to http://localhost:* for prototype use.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
DEEPSEEK_API_KEY=
# USDA FoodData Central (free key: https://fdc.nal.usda.gov/api-key-signup) — server-only,
# read exclusively by src/app/api/food-facts/route.ts. Never NEXT_PUBLIC_.
USDA_FDC_API_KEY=
